#!/bin/bash
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
hops=0
while [[ -L "$source_path" ]]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
    hops=$((hops + 1))
    if [[ $hops -gt 40 ]]; then
        printf '%s\n' 'Cannot resolve dev-cache launcher: symlink cycle.' >&2
        exit 1
    fi
done
source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
binary="$source_dir/dev-cache-go"
if [[ ! -x "$binary" ]]; then
    printf 'dev-cache binary missing. Run make build in %s\n' "$(dirname "$source_dir")" >&2
    exit 1
fi
exec "$binary" "$@"
